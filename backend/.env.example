# Real interviewer (default)
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: extended thinking for deeper multi-hop reasoning on tricky
# follow-up decisions (adds latency/cost). See agent/llm.py for details.
EXTENDED_THINKING=false
THINKING_BUDGET_TOKENS=2000

# Set LLM_PROVIDER=mock to run the full API with zero external calls --
# useful for local dev / CI without an API key. See scripts/simulate_interview.py
